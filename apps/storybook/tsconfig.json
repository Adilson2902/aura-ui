{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@aura/ui/*": ["../../packages/ui/src/*"],
      "@aura/effects": ["../../packages/effects/src/index.ts"],
      "@aura/effects/*": ["../../packages/effects/src/*"],
      "@aura/core": ["../../packages/core/src/index.ts"],
      "@aura/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": ["stories", ".storybook"]
}
