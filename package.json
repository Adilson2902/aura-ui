{
  "name": "aura-ui-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Aura UI — design system 3D standalone (shadcn + Magic UI + Aceternity)",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "storybook": "pnpm --filter @aura/storybook dev",
    "build:storybook": "pnpm --filter @aura/storybook build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
