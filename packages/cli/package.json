{
  "name": "aura-ui-cli",
  "version": "0.2.1",
  "description": "CLI Aura UI — init, add, diff, theme",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aura-ui-cli": "./dist/index.js",
    "aura-ui": "./dist/index.js",
    "aura": "./dist/index.js"
  },
  "files": [
    "dist",
    "registry"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node scripts/bundle-registry.mjs",
    "dev": "tsup src/index.ts --format esm --watch",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adilson2902/aura-ui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Adilson2902/aura-ui/tree/master/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/Adilson2902/aura-ui/issues"
  },
  "keywords": [
    "cli",
    "shadcn",
    "registry",
    "scaffold",
    "design-system",
    "3d"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
