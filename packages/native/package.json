{
  "name": "aura-ui-native",
  "version": "0.2.1",
  "description": "Aura UI para React Native — design system com 33 temas, modo escuro e componentes prontos, sem dependências nativas (funciona no Expo Go)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/test-setup.ts"
  ],
  "scripts": {
    "themes": "node scripts/build-themes.mjs",
    "build": "node scripts/build-themes.mjs && tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "node scripts/build-themes.mjs && vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.79.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adilson2902/aura-ui.git",
    "directory": "packages/native"
  },
  "homepage": "https://github.com/Adilson2902/aura-ui/tree/master/packages/native#readme",
  "bugs": {
    "url": "https://github.com/Adilson2902/aura-ui/issues"
  },
  "keywords": [
    "react-native",
    "expo",
    "design-system",
    "ui",
    "components",
    "theme",
    "dark-mode",
    "mobile"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "^0.88",
    "react-native-web": "^0.21",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^2"
  }
}
