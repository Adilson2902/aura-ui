{
  "name": "aura-ui-tailwind",
  "version": "0.2.0",
  "description": "Preset Tailwind v4 + utilitários 3D do Aura UI",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/preset.css",
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsup src/plugin.ts --format esm --dts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "aura-ui-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "tailwindcss": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aura-ui/aura-ui.git",
    "directory": "packages/tailwind-preset"
  },
  "homepage": "https://github.com/aura-ui/aura-ui#readme",
  "bugs": {
    "url": "https://github.com/aura-ui/aura-ui.git/issues"
  },
  "keywords": [
    "tailwind",
    "tailwindcss",
    "preset",
    "3d",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  }
}
